{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPS Regulation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "regulationId",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "regulationId": {
      "type": "string",
      "minLength": 1
    },
    "municipalityCode": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "name": {
      "type": "string"
    },
    "planningDocumentId": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "documentId"
      ],
      "properties": {
        "documentId": {
          "type": "string"
        },
        "article": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "FIXED",
            "CONDITIONAL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "value"
            ],
            "properties": {
              "condition": {
                "type": "string"
              },
              "value": {}
            }
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "originalText": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "FIXED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONDITIONAL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "variants"
            ]
          }
        }
      ]
    }
  }
}
