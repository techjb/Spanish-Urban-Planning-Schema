{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPS Zoning Area",
  "type": "object",
  "required": [
    "schemaVersion",
    "areaId",
    "regulationIds",
    "geometry"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Versión del esquema SUPS utilizada para interpretar este objeto."
    },
    "areaId": {
      "type": "string",
      "description": "Identificador único del ámbito o polígono de zonificación."
    },
    "regulationIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identificadores de las ordenanzas aplicables al ámbito; pueden existir varias reglas superpuestas. Puede estar vacío en un ámbito que solo represente clasificación de suelo."
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ],
          "description": "Tipo geométrico GeoJSON: Polygon o MultiPolygon."
        },
        "coordinates": {
          "type": "array",
          "description": "Coordenadas GeoJSON del polígono; respetar el orden y sistema de referencia definido por GeoJSON."
        }
      },
      "description": "Geometría poligonal GeoJSON que delimita el ámbito de zonificación."
    },
    "areaType": {
      "enum": [
        "ZONING",
        "LAND_CLASSIFICATION",
        "MIXED"
      ],
      "description": "Naturaleza del ámbito; una zona de clasificación no equivale necesariamente a una zona de ordenanza."
    },
    "landClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "URBAN",
            "DEVELOPABLE",
            "NON_DEVELOPABLE",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "category": {
          "enum": [
            "CONSOLIDATED",
            "UNCONSOLIDATED",
            "SECTORIZED",
            "NON_SECTORIZED",
            "COMMON",
            "PROTECTED",
            "UNSPECIFIED",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "originalClass": {
          "type": "string"
        },
        "originalCategory": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "sourceDocumentId": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "originalCode": {
          "type": "string"
        },
        "mappingStatus": {
          "enum": [
            "VERIFIED",
            "PROPOSED",
            "REQUIRES_REVIEW",
            "UNKNOWN"
          ]
        },
        "mappingId": {
          "type": "string"
        }
      }
    },
    "characteristicUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use"
      ],
      "description": "Uso característico normalizado del ámbito; no implica por sí mismo autorización de ese uso en cada parcela.",
      "properties": {
        "use": {
          "enum": [
            "RESIDENTIAL",
            "COMMERCIAL",
            "OFFICE",
            "HOTEL",
            "TERTIARY",
            "INDUSTRIAL",
            "LOGISTICS",
            "FACILITIES",
            "AGRICULTURAL",
            "GREEN_SPACE",
            "INFRASTRUCTURE",
            "MIXED",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador de subtipo de vocabularies/land-uses.json, validado por el catálogo."
        },
        "originalCode": {
          "type": "string"
        },
        "originalUse": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "description": "Procedencia del dato utilizado para normalizar el uso.",
          "additionalProperties": false,
          "required": ["sourceField", "originalCode", "basis"],
          "properties": {
            "sourceField": {"type": "string", "minLength": 1},
            "originalCode": {"type": "string", "minLength": 1},
            "planningInstrument": {"type": "string", "minLength": 1},
            "basis": {"enum": ["PUBLISHED_USE", "ZONING_DESIGNATION"]}
          }
        },
        "mappingStatus": {
          "enum": [
            "VERIFIED",
            "PROPOSED",
            "REQUIRES_REVIEW",
            "UNKNOWN"
          ]
        },
        "mappingId": {
          "type": "string"
        }
      }
    }
  },
  "description": "Ámbito geográfico de zonificación asociado a una o varias ordenanzas."
}
