{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPS Zoning Area",
  "type": "object",
  "required": [
    "schemaVersion",
    "areaId",
    "regulationIds",
    "geometry"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "areaId": {
      "type": "string"
    },
    "regulationIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      }
    }
  }
}
