{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUPS Urban Planning Plot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plotId",
    "parameters",
    "calculationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Versión del esquema SUPS utilizada para interpretar este objeto."
    },
    "plotId": {
      "type": "string",
      "description": "Identificador estable de la parcela urbanística dentro de la fuente de planeamiento."
    },
    "regulationRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "regulationId"
        ],
        "properties": {
          "regulationId": {
            "type": "string",
            "description": "Identificador estable y único de la ordenanza o regla urbanística normalizada."
          },
          "version": {
            "type": "string",
            "description": "Versión de la ordenanza utilizada para el cálculo."
          }
        }
      },
      "description": "Ordenanzas utilizadas para resolver los parámetros de la parcela."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "array",
          "object",
          "null"
        ]
      },
      "description": "Diccionario de parámetros SUPS, identificados por su clave normalizada del catálogo."
    },
    "calculationStatus": {
      "enum": [
        "RESOLVED",
        "PARTIAL",
        "UNKNOWN",
        "REQUIRES_REVIEW"
      ],
      "description": "Estado global de resolución: RESOLVED, PARTIAL, UNKNOWN o REQUIRES_REVIEW."
    },
    "calculatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora UTC u otra zona explícita, en formato ISO 8601, del cálculo."
    },
    "source": {
      "type": "object",
      "description": "Procedencia del identificador de parcela urbanística.",
      "required": [
        "dataset"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "featureId": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "description": "Geometría GeoJSON opcional de la parcela urbanística.",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "cadastralReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Referencias catastrales verificadas relacionadas espacialmente; no presupone equivalencia uno a uno."
    },
    "analysisUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "URBAN_PLANNING_PLOT",
            "CADASTRAL_PLOT",
            "OTHER"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relationshipStatus": {
          "enum": [
            "VERIFIED",
            "SPATIAL_OVERLAP",
            "UNKNOWN"
          ]
        }
      },
      "description": "Unidad espacial del cálculo; no presupone equivalencia entre parcelas catastrales y urbanísticas."
    },
    "parameterEvidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "method"
        ],
        "properties": {
          "status": {
            "enum": [
              "RESOLVED",
              "ESTIMATED",
              "UNKNOWN",
              "REQUIRES_REVIEW"
            ]
          },
          "method": {
            "enum": [
              "OFFICIAL",
              "CALCULATED",
              "INFERRED",
              "MANUAL_REVIEW"
            ]
          },
          "basisAreaM2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sourceRegulationIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "sourceAreaIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Evidencia y estado individual por parámetro, independiente del estado global."
    },
    "allowedUses": {
      "type": "array",
      "description": "Usos urbanísticos por unidad de análisis. Los máximos de usos diferentes no son necesariamente acumulables.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "use",
          "status",
          "role",
          "evidence"
        ],
        "properties": {
          "use": {
            "enum": [
              "RESIDENTIAL",
              "COMMERCIAL",
              "INDUSTRIAL",
              "TERTIARY",
              "OFFICE",
              "HOTEL",
              "LOGISTICS",
              "FACILITIES",
              "AGRICULTURAL",
              "OTHER"
            ]
          },
          "originalUse": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ALLOWED",
              "CONDITIONAL",
              "PROHIBITED",
              "UNKNOWN"
            ]
          },
          "role": {
            "enum": [
              "PRIMARY",
              "COMPATIBLE",
              "ALTERNATIVE",
              "COMPLEMENTARY",
              "UNKNOWN"
            ]
          },
          "maxBuildableAreaM2": {
            "type": "number",
            "minimum": 0
          },
          "maxBuildabilityRatio": {
            "type": "number",
            "minimum": 0
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method"
            ],
            "properties": {
              "status": {
                "enum": [
                  "RESOLVED",
                  "ESTIMATED",
                  "UNKNOWN",
                  "REQUIRES_REVIEW"
                ]
              },
              "method": {
                "enum": [
                  "OFFICIAL",
                  "CALCULATED",
                  "INFERRED",
                  "MANUAL_REVIEW"
                ]
              },
              "basisAreaM2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sourceRegulationIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "sourceAreaIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "landClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "verificationStatus"
      ],
      "properties": {
        "class": {
          "enum": [
            "URBAN",
            "DEVELOPABLE",
            "NON_DEVELOPABLE",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "category": {
          "enum": [
            "CONSOLIDATED",
            "UNCONSOLIDATED",
            "SECTORIZED",
            "NON_SECTORIZED",
            "COMMON",
            "PROTECTED",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "originalClass": {
          "type": "string"
        },
        "originalCategory": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "planningStatus": {
          "enum": [
            "DIRECT_DEVELOPMENT",
            "REQUIRES_MANAGEMENT",
            "REQUIRES_PLANNING",
            "RESTRICTED",
            "UNKNOWN"
          ]
        },
        "verificationStatus": {
          "enum": [
            "VERIFIED",
            "ESTIMATED",
            "UNKNOWN",
            "REQUIRES_REVIEW"
          ]
        },
        "sourceAreaIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceRegulationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "landClassificationOverlays": {
      "type": "array",
      "description": "Clasificaciones que afectan a porciones de la unidad; no inferir que la clase predominante cubre el 100%.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "areaM2",
          "sourceAreaId"
        ],
        "properties": {
          "class": {
            "enum": [
              "URBAN",
              "DEVELOPABLE",
              "NON_DEVELOPABLE",
              "OTHER",
              "UNKNOWN"
            ]
          },
          "category": {
            "type": "string"
          },
          "areaM2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sourceAreaId": {
            "type": "string"
          },
          "percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  },
  "description": "Parcela urbanística identificada en fuente de planeamiento; no equivale necesariamente a parcela catastral ni a zona de ordenanza."
}
